!composer.lock

# Node (if front-end tooling is used)
node_modules/
dist/
build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
node_modules/.cache/

# Logs/Cache/Temp
*.log
logs/
storage/
cache/
tmp/
temp/

# Uploads (runtime user files)
uploads/
public/uploads/

# Test/coverage artifacts
coverage/
.phpunit.result.cache
.clover

# SQL dumps in repo root (keep curated schemas under /sql)
/*.sql